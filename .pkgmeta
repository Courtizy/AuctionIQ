package-as: AuctionIQ

# each profession's data is its own addon, loaded on demand for the professions a character has;
# AuctionIQ_Paths (the planner and the Paths page) loads the first time Paths opens
move-folders:
  AuctionIQ/Professions/AuctionIQ_Alchemy: AuctionIQ_Alchemy
  AuctionIQ/Professions/AuctionIQ_Blacksmithing: AuctionIQ_Blacksmithing
  AuctionIQ/Professions/AuctionIQ_Enchanting: AuctionIQ_Enchanting
  AuctionIQ/Professions/AuctionIQ_Engineering: AuctionIQ_Engineering
  AuctionIQ/Professions/AuctionIQ_Inscription: AuctionIQ_Inscription
  AuctionIQ/Professions/AuctionIQ_Jewelcrafting: AuctionIQ_Jewelcrafting
  AuctionIQ/Professions/AuctionIQ_Leatherworking: AuctionIQ_Leatherworking
  AuctionIQ/Professions/AuctionIQ_Tailoring: AuctionIQ_Tailoring
  AuctionIQ/Professions/AuctionIQ_Paths: AuctionIQ_Paths
  # months of daily prices, written by its companion.py
  AuctionIQ/Companion/AuctionIQ_History: AuctionIQ_History

ignore:
  - tests
  - tools
  - README.md
  - .github
  - Media/Logo-512.png
  - Media/readme
